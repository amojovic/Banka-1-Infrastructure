# =============================================================================
# Banka-1 Infrastructure — Kubernetes Secrets (namespace: banka-1)
# =============================================================================
# OVO JE TEMPLATE (.example). NE primenjuj ga sa REPLACE_ME vrednostima i NIKAD
# ne commituj realne vrednosti u git.
#
# WORKFLOW PRI DEPLOY-u:
#   1) cp secrets.yaml.example secrets.yaml   (secrets.yaml drzi u .gitignore)
#   2) Popuni SVE REPLACE_ME-* placeholder-e pravim vrednostima.
#   3) kubectl apply -f secrets.yaml -n banka-1   (PRE Deployment-a — bez Secret-a
#      pod ne startuje jer se secretKeyRef env ne resolve-uje).
#
# ALTERNATIVA (preferirano za prod — vrednosti ne diraju disk):
#   kubectl create secret generic ... --from-literal=...  (vidi SECRETS.md)
#
# Crunchy PostgreSQL kredencijali NISU ovde — PG operator ih auto-generise u
# Secret-e db-pguser-<user> (user-service, banking-core, market-service, trading,
# credit, notification, saga, interbank). Deployment-i ih vec citaju preko
# secretKeyRef-a. Ne diramo ih.
# =============================================================================
---
# -----------------------------------------------------------------------------
# app-secrets — deljene aplikativne tajne.
#   JWT_SECRET             : HS256 potpis (min 256-bit). Deljen kroz SVE servise
#                            (svi verifikuju isti token). saga/interbank PROFILE=prod
#                            odbijaju prazan/dev secret — MORA biti popunjen.
#   ALPHA_VANTAGE_API_KEY  : market-service eksterni stock feed (Alpha Vantage).
#   TWELVE_DATA_API_KEY    : market-service eksterni FX feed (Twelve Data).
#                            Oba mogu biti prazna (servis radi bez live feed-a),
#                            ali kljucevi MORAJU postojati jer ih Deployment refer.
# -----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: banka-1
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_ME-jwt-openssl-rand-base64-64"
  ALPHA_VANTAGE_API_KEY: "REPLACE_ME-or-empty"
  TWELVE_DATA_API_KEY: "REPLACE_ME-or-empty"
---
# -----------------------------------------------------------------------------
# interbank-partners — registar partnerskih banaka za interbank-service.
#   INTERBANK_PARTNERS_JSON : JSON []Partner (jedini env koji loader cita za partnere;
#                             per-field secret env-ovi NE rade jer envconfig ne
#                             podrzava slice-of-struct indeksiranje).
#
#   Registruje Banka 2 (routing 222):
#     InboundToken  = token koji Banka 1 OCEKUJE na pozivima OD Banke 2
#                     (= sto Banka 2 SALJE kad zove nas).
#     OutboundToken = token koji Banka 1 SALJE kad zove Banku 2.
#   BaseURL = https://banka-2.radenkovic.rs/api  (Banka 2 inbound je POD /api).
#   PROFILE=prod fail-fast-uje ako token pocinje sa "dev-" ili je prazan. Zameni
#   REPLACE_ME-* placeholder-e pravim 64-hex tokenima PRE apply-a. NE commit-uj realne
#   vrednosti — prave tokene + kubectl komande drzi interni deploy dokument.
# -----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: interbank-partners
  namespace: banka-1
type: Opaque
stringData:
  INTERBANK_PARTNERS_JSON: |-
    [{"Routing":222,"DisplayName":"Banka 2","BaseURL":"https://banka-2.radenkovic.rs/api","InboundToken":"REPLACE_ME-interbank-inbound-token-64hex","OutboundToken":"REPLACE_ME-interbank-outbound-token-64hex"}]
---
# -----------------------------------------------------------------------------
# rabbitmq-credentials — dedicated RabbitMQ user (zamenjuje guest/guest).
#   Isti user/pass za broker i sve consumere/producer-e.
# -----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-credentials
  namespace: banka-1
type: Opaque
stringData:
  RABBITMQ_DEFAULT_USER: "banka1"
  RABBITMQ_DEFAULT_PASS: "REPLACE_ME-rabbitmq-pass-openssl-rand-hex-16"
---
# -----------------------------------------------------------------------------
# influxdb-credentials — InfluxDB 2.x bootstrap admin + write token.
#   INFLUX_ADMIN_TOKEN se koristi i kao market-service write token
#   (STOCK_INFLUX_TOKEN) — MORA biti ista vrednost na obe strane, min 32 bajta.
# -----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: influxdb-credentials
  namespace: banka-1
type: Opaque
stringData:
  INFLUX_ADMIN_USERNAME: "banka1-admin"
  INFLUX_ADMIN_PASSWORD: "REPLACE_ME-influx-admin-password-openssl-rand-hex-16"
  INFLUX_ADMIN_TOKEN: "REPLACE_ME-influx-admin-token-openssl-rand-hex-32-min-32-bytes"
---
# -----------------------------------------------------------------------------
# mail-credentials — Gmail SMTP za notification-service.
#   MAIL_PASSWORD = Gmail "App password" (16-char, zahteva 2FA), NE regular pwd.
#   Prazno -> SMTP tiho fail-uje. https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: mail-credentials
  namespace: banka-1
type: Opaque
stringData:
  MAIL_USERNAME: "REPLACE_ME-gmail-username"
  MAIL_PASSWORD: "REPLACE_ME-gmail-app-password"
